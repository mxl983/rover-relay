# Rover Dashboard – environment (copy to .env.local)
# Dashboard runs on another device in the same Tailscale tailnet — use FQDNs.

# Pi MagicDNS name (no protocol, no trailing slash). Change when moving tailnets.
VITE_PI_FQDN=raspberrypi.tail9d0237.ts.net

# Optional aliases / overrides (defaults derive from VITE_PI_FQDN):
# VITE_WEBRTC_BASE=https://raspberrypi.tail9d0237.ts.net:8889
# Mentori drive/status is proxied through HTTPS :3000 (phones often fail :5000).
# VITE_MENTOR_API_BASE=https://raspberrypi.tail9d0237.ts.net:3000
# VITE_WEBRTC_PORT=8889
# VITE_MENTOR_API_PORT=5000

# Stick → Twist scale (m/s, rad/s); match MentorPi web_car (after DRIVE_CMD_SCALE)
# VITE_DRIVE_CMD_SCALE=1
# VITE_MENTOR_MAX_LINEAR=0.35
# VITE_MENTOR_MAX_ANGULAR=0.9

# MQTT login / wake (HiveMQ Cloud cluster — no protocol credentials here;
# operator username/password are entered on the login screen and stored in the browser).
VITE_MQTT_HOST=wss://a4ad037d8b304c56a8e60e1a1e163842.s1.eu.hivemq.cloud:8884/mqtt
# esp-web-arduino topics / GPIO main circuit
# VITE_MQTT_CMD_TOPIC=rover/web/cmd
# VITE_MQTT_STATUS_TOPIC=rover/web/status
# VITE_MQTT_POWER_GPIO=13
# VITE_MQTT_POWER_OFF_DELAY_SEC=15

# VITE_CAMERA_SECRET=
# VITE_VOICE_DRIVE_DEBUG=true
# VITE_JOYSTICK_DRIVE_DEBUG=false
